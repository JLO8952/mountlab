 "version": 1,
 "unidad": "und",
 "ficha": {
  "descripcion": "Placa azul con el transceptor MAX3232 que convierte señales RS232 (±5 a ±6 V, conector DB9 hembra) a niveles TTL de 3.3 V o 5 V para microcontroladores. Header de 4 pines (GND, TXD, RXD, VCC), LED D1 de encendido y dos agujeros de fijación.",
  "funcionamiento": "Las bombas de carga internas del MAX3232 (con los capacitores C1–C4) generan los voltajes positivo y negativo de RS232 desde 3.3 o 5 V. Un canal: lo que entra por RXD (TTL) sale por el pin 2 del DB9 (T1OUT) y lo que llega al pin 3 del DB9 (R1IN) sale por TXD (TTL). El pin 5 del DB9 es tierra. Sirve para conectar un microcontrolador al puerto COM de un PC, PLC, router, DVD u otro equipo con RS232.",
  "voltaje": "3.3–5 V (MAX3232: 3.0–5.5 V); TTL del mismo nivel que VCC; salida RS232 ≈ ±5.4 V",
  "corriente": "≈0.3 mA el MAX3232 sin carga (1 mA máx.) + LED ≈1–3 mA",
  "interfaz": "UART TTL ↔ RS232 (1 canal TX/RX, sin RTS/CTS); hasta 250 kbit/s",
  "entradas": "RXD (TTL desde el TX del microcontrolador); pin 3 del DB9 (RS232)",
  "salidas": "TXD (TTL al RX del microcontrolador); pin 2 del DB9 (RS232)",
  "dimensiones": "PCB ≈30.8 × 28.8 mm; altura ≈14 mm con el DB9; el frente del DB9 sobresale ≈6 mm del borde (confianza media)",
  "datasheet": "https://www.ti.com/lit/ds/symlink/max3232.pdf",
  "notas": "Ojo con los nombres: TXD es la salida del módulo (va al RX del micro) y RXD es la entrada (va al TX del micro); si no hay datos, cruzarlos. El DB9 es hembra con cableado tipo DCE: conecta directo al puerto macho de un PC con cable recto. Para un equipo con DB9 hembra usar cable null-modem o adaptador. Sin RTS/CTS ni DTR. El chip suelto está en la biblioteca como max3232_soic16. Medidas de la placa con 2 fuentes de vendedor y la foto; agujeros y posición de piezas estimados: verificar con calibrador."
 },
 "especificaciones": [
  {
   "param": "Chip",
   "valor": "MAX3232 (SOIC-16), compatible MAX3232/SP3232"
  },
  {
   "param": "Canales usados",
   "valor": "1 TX + 1 RX (el chip trae 2 + 2)"
  },
  {
   "param": "Velocidad",
   "valor": "Hasta 250 kbit/s (datasheet TI); en módulo, uso típico 9600–115200 baud"
  },
  {
   "param": "Alimentación",
   "valor": "3.3 V o 5 V"
  },
  {
   "param": "Conector RS232",
   "valor": "DB9 hembra en ángulo con tornillos 4-40: pin 2 = TX (T1OUT), pin 3 = RX (R1IN), pin 5 = GND"
  },
  {
   "param": "Conector TTL",
   "valor": "Header macho 4 pines paso 2.54 mm: GND, TXD, RXD, VCC"
  },
  {
   "param": "Indicador",
   "valor": "LED D1 de encendido"
  },
  {
   "param": "Fijación",
   "valor": "2 agujeros ≈Ø3 mm (M2.5/M3) en el borde opuesto al DB9"
  },
  {
   "param": "Protección ESD",
   "valor": "±15 kV en líneas RS232 (según el chip)"
  },
  {
   "param": "Temperatura",
   "valor": "−40 a +85 °C (chip MAX3232E/I)"
  }
 ],

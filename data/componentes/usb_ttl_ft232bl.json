   "valor": "5 V o 3.3 V con jumper (3V3 · S1 · 5V)"
  },
  {
   "param": "LEDs",
   "valor": "LD1 y LD2 (TX/RX), LD3 encendido"
  },
  {
   "param": "Protección",
   "valor": "Fusible F1 en VBUS, capacitor de tantalio 10 µF/16 V"
  },
  {
   "param": "Drivers",
   "valor": "FTDI VCP (Windows, Linux y macOS: incluidos)"
  }
 ],
